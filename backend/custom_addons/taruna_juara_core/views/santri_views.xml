<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_taruna_santri_tree" model="ir.ui.view">
        <field name="name">taruna.santri.tree</field>
        <field name="model">taruna.santri</field>
        <field name="arch" type="xml">
            <tree string="Mahasantri Aktif">
                <field name="nis"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="university"/>
                <field name="semester"/>
                <field name="hafalan_juz"/>
                <field name="ustadz_id"/>
                <field name="kamar_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_taruna_santri_form" model="ir.ui.view">
        <field name="name">taruna.santri.form</field>
        <field name="model">taruna.santri</field>
        <field name="arch" type="xml">
            <form string="Profil Mahasantri">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="nis" placeholder="NIS"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Nama Mahasantri"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Identitas &amp; Kontak">
                            <field name="nik"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="status"/>
                        </group>
                        <group string="Akademik &amp; Hafalan">
                            <field name="university"/>
                            <field name="faculty"/>
                            <field name="major"/>
                            <field name="semester"/>
                            <field name="hafalan_juz"/>
                        </group>
                    </group>
                    <group string="Pembimbing &amp; Asrama">
                        <field name="ustadz_id"/>
                        <field name="kamar_id"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_taruna_santri" model="ir.actions.act_window">
        <field name="name">Mahasantri &amp; Alumni</field>
        <field name="res_model">taruna.santri</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
